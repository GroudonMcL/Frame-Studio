{
  "name": "frame-studio",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "A visual editor for code-drawn token frames.",
  "author": "GroudonMcL",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "engine:check": "tsx scripts/engine-sync.ts check",
    "engine:sync": "tsx scripts/engine-sync.ts sync",
    "frame-sheet": "tsx scripts/frame-sheet.ts",
    "effects-sheet": "tsx scripts/effects-sheet.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "compare-conversions": "tsx scripts/compare-conversions.ts",
    "share:check": "tsx scripts/share-export.ts check",
    "share:export": "tsx scripts/share-export.ts export",
    "make-fixtures": "tsx scripts/make-fixtures.ts",
    "look": "tsx scripts/look.ts",
    "desktop": "npm run build && electron .",
    "installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/grenze": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.groudonmcl.framestudio",
    "productName": "Frame Studio",
    "directories": {
      "buildResources": "desktop/resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Frame Studio",
      "artifactName": "Frame-Studio-Setup-${version}.exe"
    }
  }
}
